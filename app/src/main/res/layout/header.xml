<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/brand_blue"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/white"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />
        <!-- Hidden by default -->

        <!-- Logo & App Name -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_school_hat_24"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <!-- Admin Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeaderAdmin"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/admin"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_admin_panel_settings_24"
            app:iconTint="@color/white"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent"
            android:layout_marginEnd="8dp" />

        <!-- Notification Bell -->
        <ImageView
            android:id="@+id/btnNotifications"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notifications_24"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Greeting -->
    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/greeting_morning"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/greeting_sub"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

</LinearLayout>